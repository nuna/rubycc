  "popular_control": {
    "source": "rubygems.org popular",
    "rank_range": "1-100",
    "command": "ruby tools/scan_popular_gems.rb 1 10 --artifact ARTIFACT",
    "artifact": "artifacts/pilot-v2/popular-control.json",
    "fixed_before_candidate_selection": true
  },
  "candidate_selection": {
    "maximum_unique_gems": 3,
    "identity": "gem name; retain the fixed version/platform/SHA record for inspection",
    "exclude": [
      "already in test/corpus/gems.rb",
      "present in the fixed popular rank 1-100 control",
      "duplicate gem names across windows"
    ],
    "priority": [
      "new gap header",
      "new system header",
      "new extension or build shape",
      "version_downloads descending",
      "created_at descending",
      "gem name ascending"
    ],
    "review_boundary": "static evidence selects; inspect-corpus-candidate and manual validation decide next action"
  },
  "operating_targets": {
    "daily_wall_time_p95_seconds": 900,
    "timeout_rate": 0,
    "final_failure_rate_less_than": 0.05,
    "measure": [
      "phase elapsed seconds",
      "wall time",
      "maximum work-space bytes",
      "review minutes per candidate"
    ]
  },
  "replay_policy": {
    "failed_window": "replay the exact same from/to interval and scanner revision",
    "missing_window": "not counted in the denominator until a successful replay exists",
    "discard_or_replace_window": false,
    "extend_to_28_days_only_when": "the primary 14 completed windows contain zero eligible candidates"
  },
  "artifact_policy": {
    "ignored_work_prefix": "docs/development/corpus-candidate-evaluation/artifacts/",
    "commit": [
      "this manifest",
      "pilot metrics",
      "review report",
      "STEPS summary"
    ],
    "never_commit": [
      "raw responses",
      "gem archives",
      "unpack trees",
      "candidate logs"
    ],
    "corpus_or_verified_gems_changes": false
  },
  "inspection": {
    "local_skill": "inspect-corpus-candidate",
    "maximum_candidates": 3,
    "manual_validation": true,
    "build_load_requires_explicit_request": true,
    "upstream_recipe_required": true
  }
}
